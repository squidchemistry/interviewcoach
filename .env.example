# Copy to .env and fill in. Never commit .env.

# LLM: auto = Groq if GROQ_API_KEY is set, otherwise the offline mock.
LLM_PROVIDER=auto
GROQ_API_KEY=
# Tried in order; the next model is used if one is retired or failing.
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Database (docker compose sets this for you)
DATABASE_URL=postgresql+psycopg://coach:coach@localhost:5432/interviewcoach
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# App
APP_ENV=development
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=false
# Max LLM-backed requests per client IP per minute (0 disables)
RATE_LIMIT_PER_MINUTE=20

# Host ports used by docker compose
API_PORT=8000
WEB_PORT=3000
