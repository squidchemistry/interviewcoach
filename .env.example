# Copy to `.env` (git-ignored) and change the values. These defaults are for LOCAL DEVELOPMENT ONLY.
# docker compose reads this file automatically; `mvnw spring-boot:run` also imports ../.env.

# --- PostgreSQL (pgvector) ---
POSTGRES_DB=aicoach
POSTGRES_USER=aicoach
POSTGRES_PASSWORD=change-me-local-postgres

# --- Redis ---
REDIS_PASSWORD=change-me-local-redis

# --- Host ports (change if something else on your machine already uses them) ---
WEB_PORT=8088
API_PORT=8080

# --- API ---
# Comma-separated exact origins allowed to call the API with credentials (no wildcards):
# the Vite dev server (5173) and the dockerised web app (WEB_PORT).
CORS_ORIGINS=http://localhost:5173,http://localhost:8088
# Maximum JSON request body in bytes (default 100 KB).
HTTP_MAX_BODY_BYTES=102400
# Where the web app is served; Google sign-in redirects the browser back here.
WEB_BASE_URL=http://localhost:8088

# --- Auth ---
# HS256 signing key for access tokens: base64, at least 32 bytes. This value is for LOCAL USE ONLY.
# Generate your own with:  openssl rand -base64 48
JWT_SECRET=bG9jYWwtZGV2LW9ubHktand0LXNlY3JldC0tbmV2ZXItdXNlLWluLXByb2R1Y3Rpb24hIQ==
# Refresh cookie `Secure` flag. false only for plain-http localhost; always true in production.
COOKIE_SECURE=false

# --- Demo data (creates demo@aicoach.dev and admin@aicoach.dev on startup; never enable in production) ---
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=DemoPass2026
ADMIN_PASSWORD=AdminPass2026

# --- Google sign-in (optional; the button is hidden unless all three are set) ---
# Create an OAuth client (Web application) at https://console.cloud.google.com/apis/credentials and add the
# redirect URI below as an "Authorized redirect URI".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8088/api/v1/auth/google/callback

# --- AI provider ---
# mock = deterministic, offline, clearly labelled MOCK output (no key needed). anthropic | openai = real models.
# `openai` also covers OpenAI-compatible endpoints (e.g. Gemini's) through AI_BASE_URL.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5
# Token budgets (interviews end gracefully when exhausted).
AI_SESSION_TOKEN_BUDGET=80000
AI_DAILY_TOKEN_BUDGET=400000
# Embeddings for "similar questions": mock (hashing, offline) | openai (text-embedding-3-small, 1024 dims).
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_API_KEY=

# --- Code execution (DSA rounds) ---
# mock = code is NOT run; results say so (refused with the prod profile). judge0 = run in the Judge0 sandbox.
CODE_EXECUTOR=mock
JUDGE0_URL=http://judge0-server:2358

# --- Payments (Pro plan) ---
# mock = no real money; a clearly labelled "test mode" button activates Pro. razorpay = real Razorpay Subscriptions.
PAYMENTS_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
# Free plan: interviews per calendar month.
FREE_MONTHLY_INTERVIEWS=3

# --- Judge0 sandbox (only used with `docker compose --profile judge0 up`) ---
JUDGE0_DB_PASSWORD=change-me-local-judge0-db
JUDGE0_REDIS_PASSWORD=change-me-local-judge0-redis
JUDGE0_AUTH_TOKEN=change-me-local-judge0-token
